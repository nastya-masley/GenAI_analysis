GEMINI_API_KEY=replace-with-your-key
GEMINI_MODEL=gemini-2.5-flash
MAX_VIDEO_SIZE_MB=250
PORT=3000
# "High demand" fallback for /api/analyze: when the primary key/model returns an
# overload/quota error (HTTP 429/503/500/403), the server retries with this
# higher-tier key across GEMINI_FALLBACK_MODELS, in order. Leave GEMINI_FALLBACK_API_KEY
# unset to disable the fallback (single-attempt behaviour). The fallback key is never logged.
# GEMINI_FALLBACK_API_KEY=replace-with-tier1-key
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash
# Optional: override the Gemini REST + File API host (testing/proxy only).
# GEMINI_FILE_API_BASE=https://generativelanguage.googleapis.com
# Passphrase that enables the hidden runtime key-replacement feature (Ctrl+Alt+K or
# the #set-api-key URL → POST /api/admin/gemini-key). The feature is DISABLED until
# this is set. A key swapped in this way is saved to .gemini-key and overrides
# GEMINI_API_KEY on the next boot. Leave unset to disable runtime key replacement.
# ADMIN_TOKEN=choose-a-strong-passphrase
